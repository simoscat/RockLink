<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.LoginFormController">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT">
            <HBox styleClass="brand" alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="brand-logo">
                    <Label text="⚡" styleClass="brand-logo-icon"/>
                </StackPane>
                <Label text="ROCK LINK" styleClass="brand-title"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="themeToggleButton" text="☀" styleClass="icon-button" onAction="#onThemeToggle"/>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="page-center">
            <VBox spacing="6.0" styleClass="content-box" maxWidth="420.0">

                <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="login-top-row">
                    <Button fx:id="backButton" text="‹" styleClass="icon-button, back-button" onAction="#handleBack"/>
                    <Label fx:id="roleBadgeLabel" text="MUSICISTA" styleClass="role-badge"/>
                </HBox>

                <Label text="BENTORNATO" styleClass="login-title"/>
                <Label fx:id="subtitleLabel" text="Accedi al tuo account musicista" styleClass="login-subtitle"/>

                <VBox fx:id="loginCard" styleClass="login-card" spacing="16.0">

                    <Label fx:id="loginErrorLabel" text="" styleClass="error-label"
                           visible="false" managed="false" wrapText="true"/>

                    <VBox spacing="6.0">
                        <Label text="EMAIL" styleClass="field-label"/>
                        <TextField fx:id="emailField" promptText="es. marco.rossi@email.it" styleClass="text-input"/>
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="PASSWORD" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-input"/>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT">
                        <Hyperlink fx:id="forgotPasswordLink" text="Password dimenticata?"
                                   onAction="#handleForgotPassword" styleClass="muted-link"/>
                    </HBox>

                    <Button fx:id="loginButton" text="ACCEDI" onAction="#handleLogin" styleClass="btn-primary"/>

                </VBox>

                <HBox spacing="6.0" alignment="CENTER" styleClass="register-row">
                    <Label text="Non hai un account?" styleClass="muted-text"/>
                    <Hyperlink fx:id="registerLink" text="Registrati" onAction="#handleRegister" styleClass="inline-link"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>

    <bottom>
        <StackPane styleClass="app-footer">
            <Label text="Connecting Musicians · Join Bands · Find Gigs" styleClass="footer-tagline"/>
            <Button fx:id="helpButton" text="?" styleClass="help-button" onAction="#onHelp" StackPane.alignment="BOTTOM_RIGHT"/>
        </StackPane>
    </bottom>

</BorderPane>
