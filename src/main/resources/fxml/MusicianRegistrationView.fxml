<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="rootPane" prefHeight="800.0" prefWidth="1280.0"
            styleClass="root-pane" stylesheets="@../css/musician-signup-style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <fx:define>
        <ToggleGroup fx:id="genderToggleGroup" />
        <ToggleGroup fx:id="skillToggleGroup" />
    </fx:define>

    <!-- ===================== TOP BAR / LOGO + BACK TO LOGIN ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="top-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="24.0" left="34.0" right="34.0" top="24.0" />
            </padding>
            <StackPane styleClass="logo-icon">
                <SVGPath content="M13,1 L6,13 L11,13 L9,23 L18,9 L12,9 Z" scaleX="0.667" scaleY="0.667" styleClass="logo-icon-text" />
            </StackPane>
            <Label styleClass="logo-text" text="ROCKLINK" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="backToLoginButton" mnemonicParsing="false" onAction="#handleBackToLogin"
                    styleClass="back-button" text="‹ Back to login" />
        </HBox>
    </top>

    <!-- ===================== CENTER CONTENT ===================== -->
    <center>
        <!-- The entire form scrolls vertically if it does not fit the window height,
             so no section (e.g. the instruments list or the final button)
             stays hidden off-screen. -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll"
                    vbarPolicy="AS_NEEDED" BorderPane.alignment="TOP_CENTER">
        <VBox alignment="TOP_CENTER" spacing="0.0">
        <VBox alignment="TOP_LEFT" maxWidth="520.0" prefWidth="520.0" spacing="0.0">
            <padding>
                <Insets bottom="40.0" top="34.0" />
            </padding>

            <Label styleClass="role-badge, role-badge-musician" text="MUSICIAN" />

            <Label styleClass="page-title" text="SIGN UP">
                <VBox.margin>
                    <Insets top="14.0" />
                </VBox.margin>
            </Label>

            <Label styleClass="welcome-subtitle" text="Create your musician account">
                <VBox.margin>
                    <Insets bottom="26.0" top="6.0" />
                </VBox.margin>
            </Label>

            <!-- ===================== FORM PANEL ===================== -->
            <VBox styleClass="panel">
                <VBox styleClass="panel-top-border, border-musician" />
                <VBox spacing="20.0" styleClass="panel-body">
                    <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="24.0" />
                    </padding>

                    <!-- First / Last name -->
                    <HBox spacing="16.0">
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="FIRST NAME" />
                            <TextField fx:id="firstNameField" maxWidth="1.7976931348623157E308" promptText="e.g. Marco" styleClass="text-field" />
                        </VBox>
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="LAST NAME" />
                            <TextField fx:id="lastNameField" maxWidth="1.7976931348623157E308" promptText="e.g. Rossi" styleClass="text-field" />
                        </VBox>
                    </HBox>

                    <!-- Stage name -->
                    <VBox spacing="7.0">
                        <Label styleClass="field-label" text="STAGE NAME" />
                        <TextField fx:id="stageNameField" maxWidth="1.7976931348623157E308" promptText="e.g. Sonic Wolf" styleClass="text-field" />
                    </VBox>

                    <!-- Gender -->
                    <VBox spacing="10.0">
                        <Label styleClass="field-label" text="GENDER" />
                        <HBox spacing="12.0">
                            <ToggleButton fx:id="genderMaleToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="gender-toggle" text="Male" toggleGroup="$genderToggleGroup" HBox.hgrow="ALWAYS" />
                            <ToggleButton fx:id="genderFemaleToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="gender-toggle" text="Female" toggleGroup="$genderToggleGroup" HBox.hgrow="ALWAYS" />
                            <ToggleButton fx:id="genderNotSpecifiedToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="gender-toggle" text="Not specified" toggleGroup="$genderToggleGroup" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Email -->
                    <VBox spacing="7.0">
                        <Label styleClass="field-label" text="EMAIL" />
                        <TextField fx:id="emailField" maxWidth="1.7976931348623157E308" promptText="e.g. marco.rossi@email.com" styleClass="text-field" />
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="7.0">
                        <Label styleClass="field-label" text="PASSWORD" />
                        <TextField fx:id="passwordField" maxWidth="1.7976931348623157E308" promptText="••••••••" styleClass="text-field" />
                    </VBox>

                    <!-- Instruments -->
                    <VBox spacing="10.0">
                        <Label styleClass="field-label" text="INSTRUMENTS" />

                        <VBox spacing="0.0" styleClass="instruments-box">
                            <padding>
                                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                            </padding>

                            <!-- Scrollable list of instrument entries: if the user adds many,
                                 this area scrolls internally instead of growing the page. -->
                            <ScrollPane fx:id="instrumentsScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                                        maxHeight="260.0" minHeight="140.0" prefHeight="140.0"
                                        styleClass="instruments-scroll" vbarPolicy="AS_NEEDED">
                                <VBox fx:id="instrumentsContainer" spacing="14.0">

                                    <!-- First instrument row: also acts as a template for the ones
                                         added at runtime by the controller on "+ Add instrument". -->
                                    <VBox spacing="10.0">
                                        <TextField fx:id="instrumentNameField" maxWidth="1.7976931348623157E308" promptText="Instrument name (e.g. Guitar)" styleClass="text-field" />
                                        <HBox spacing="8.0">
                                            <ToggleButton fx:id="skillAmateurToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="skill-toggle" text="AMATEUR" toggleGroup="$skillToggleGroup" HBox.hgrow="ALWAYS" />
                                            <ToggleButton fx:id="skillBeginnerToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="skill-toggle" text="BEGINNER" toggleGroup="$skillToggleGroup" HBox.hgrow="ALWAYS" />
                                            <ToggleButton fx:id="skillIntermediateToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="skill-toggle" text="INTERMEDIATE" toggleGroup="$skillToggleGroup" HBox.hgrow="ALWAYS" />
                                            <ToggleButton fx:id="skillExpertToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="skill-toggle" text="EXPERIENCED" toggleGroup="$skillToggleGroup" HBox.hgrow="ALWAYS" />
                                            <ToggleButton fx:id="skillMasterToggle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="skill-toggle" text="MASTER" toggleGroup="$skillToggleGroup" HBox.hgrow="ALWAYS" />
                                        </HBox>
                                    </VBox>

                                </VBox>
                            </ScrollPane>
                        </VBox>

                        <Button fx:id="addInstrumentButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAddInstrument" styleClass="add-instrument-btn" text="+ Add instrument">
                            <VBox.margin>
                                <Insets top="12.0" />
                            </VBox.margin>
                        </Button>
                    </VBox>

                    <!-- Create account -->
                    <Button fx:id="createAccountButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCreateAccount" styleClass="sign-in-btn, sign-in-btn-musician" text="CREATE ACCOUNT">
                        <VBox.margin>
                            <Insets top="6.0" />
                        </VBox.margin>
                    </Button>

                </VBox>
            </VBox>

        </VBox>
        </VBox>
        </ScrollPane>
    </center>

    <!-- ===================== FOOTER ===================== -->
    <bottom>
        <VBox alignment="CENTER" styleClass="footer-box" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="22.0" top="18.0" />
            </padding>
            <Label styleClass="footer-text" text="Connecting Musicians · Join Bands · Find Jobs" />
        </VBox>
    </bottom>

</BorderPane>
