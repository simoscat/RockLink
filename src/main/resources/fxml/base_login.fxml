<?xml version="1.0" encoding="UTF-8"?>

<!--
    ROCK LINK — base_login.fxml
    Initial screen: role selection (Musician / Promoter).
    No fx:controller attached: add one and wire onAction on the
    buttons/Hyperlinks when navigation logic is needed.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="page-bg" prefWidth="1440" prefHeight="900"
            stylesheets="@../css/style.css">

    <!-- HEADER -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10">
            <StackPane styleClass="logo-icon-box">
                <Label text="⚡" styleClass="logo-icon-symbol"/>
            </StackPane>
            <Label text="ROCK LINK" styleClass="logo-title"/>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox alignment="CENTER" spacing="36">

            <VBox alignment="CENTER" spacing="10">
                <Label text="WELCOME" styleClass="page-heading"/>
                <Label text="Select your role to continue" styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="16" alignment="CENTER">

                <!-- MUSICIAN CARD -->
                <VBox styleClass="role-card" spacing="14">
                    <StackPane styleClass="role-icon-box, role-icon-musician">
                        <Label text="🎸" styleClass="role-icon-symbol-orange"/>
                    </StackPane>
                    <Label text="MUSICIAN" styleClass="role-card-title"/>
                    <Label text="Find bands, apply to gigs" styleClass="role-card-subtitle-orange"/>
                    <Label text="Are you an independent musician? Find your band, apply to live gigs and showcase your talent."
                           styleClass="role-card-desc" wrapText="true"/>
                    <Hyperlink fx:id="musicianContinueLink" text="Continue  ›" styleClass="role-card-link-orange"/>
                </VBox>

                <!-- PROMOTER CARD -->
                <VBox styleClass="role-card" spacing="14">
                    <StackPane styleClass="role-icon-box, role-icon-promoter">
                        <Label text="💼" styleClass="role-icon-symbol-yellow"/>
                    </StackPane>
                    <Label text="PROMOTER" styleClass="role-card-title"/>
                    <Label text="Discover talent, post gigs" styleClass="role-card-subtitle-yellow"/>
                    <Label text="Do you organize events or manage a venue? Post job offers, find bands and manage your shows."
                           styleClass="role-card-desc" wrapText="true"/>
                    <Hyperlink fx:id="promoterContinueLink" text="Continue  ›" styleClass="role-card-link-yellow"/>
                </VBox>

            </HBox>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?" styleClass="helper-text"/>
                <Hyperlink fx:id="loginLink" text="Log in" styleClass="link-orange"/>
            </HBox>

        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <VBox alignment="CENTER">
            <padding><Insets top="20" bottom="24"/></padding>
            <Label text="Connecting Musicians · Join Bands · Find Gigs" styleClass="footer-text"/>
        </VBox>
    </bottom>

</BorderPane>
