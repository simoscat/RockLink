<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="rootPane" prefHeight="952.0" prefWidth="1576.0"
            styleClass="root-pane" stylesheets="@../css/login-style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ===================== TOP BAR / LOGO ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="top-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="24.0" left="34.0" right="34.0" top="24.0" />
            </padding>
            <StackPane styleClass="logo-icon">
                <SVGPath content="M13,1 L6,13 L11,13 L9,23 L18,9 L12,9 Z" scaleX="0.667" scaleY="0.667" styleClass="logo-icon-text" />
            </StackPane>
            <Label styleClass="logo-text" text="ROCKLINK" />
        </HBox>
    </top>

    <!-- ===================== CENTER CONTENT ===================== -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="0.0" styleClass="center-box" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" top="70.0" />
            </padding>

            <Label styleClass="welcome-title" text="WELCOME BACK" />
            <Label styleClass="welcome-subtitle" text="Sign in to your account">
                <VBox.margin>
                    <Insets bottom="46.0" top="10.0" />
                </VBox.margin>
            </Label>

            <HBox alignment="CENTER" spacing="32.0">

                <!-- ===================== MUSICIAN PANEL ===================== -->
                <VBox prefWidth="352.0" spacing="0.0" styleClass="panel">
                    <VBox styleClass="panel-top-border, border-musician" />
                    <VBox spacing="20.0" styleClass="panel-body">
                        <padding>
                            <Insets bottom="28.0" left="28.0" right="28.0" top="26.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane styleClass="icon-box, icon-box-musician">
                                <SVGPath content="M9,10 L15,10 L19,13 L19,19 L15,23 L9,23 L5,19 L5,13 Z M11,1 L13,1 L13,10 L11,10 Z M9,0.2 L15,0.2 L13.2,2.2 L10.8,2.2 Z M7,15 L17,15 L17,15.8 L7,15.8 Z M7,17.2 L17,17.2 L17,18 L7,18 Z M7,19.5 L17,19.5 L17,20.1 L7,20.1 Z" scaleX="0.75" scaleY="0.75" styleClass="icon-box-text, icon-text-musician" />
                            </StackPane>
                            <VBox spacing="3.0">
                                <Label styleClass="panel-title" text="MUSICIAN" />
                                <Label styleClass="panel-subtitle, subtitle-musician" text="Find bands, apply to jobs" />
                            </VBox>
                        </HBox>

                        <VBox spacing="7.0">
                            <Label styleClass="field-label" text="EMAIL" />
                            <TextField fx:id="musicianEmailField" promptText="e.g. marco.rossi@email.com" styleClass="text-field" />
                        </VBox>

                        <VBox spacing="7.0">
                            <Label styleClass="field-label" text="PASSWORD" />
                            <PasswordField fx:id="musicianPasswordField" promptText="••••••••" styleClass="text-field" />
                        </VBox>

                        <HBox alignment="CENTER_RIGHT">
                            <Label styleClass="forgot-link" text="Forgot password?" />
                        </HBox>

                        <Button fx:id="musicianSignInButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMusicianSignIn" styleClass="sign-in-btn, sign-in-btn-musician" text="SIGN IN">
                            <VBox.margin>
                                <Insets top="6.0" />
                            </VBox.margin>
                        </Button>
                    </VBox>
                </VBox>

                <!-- ===================== PROMOTER PANEL ===================== -->
                <VBox prefWidth="352.0" spacing="0.0" styleClass="panel">
                    <VBox styleClass="panel-top-border, border-promoter" />
                    <VBox spacing="20.0" styleClass="panel-body">
                        <padding>
                            <Insets bottom="28.0" left="28.0" right="28.0" top="26.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane styleClass="icon-box, icon-box-promoter">
                                <SVGPath content="M2,7 L22,7 L22,20 L2,20 Z M8,2 L9.4,2 L9.4,7.5 L8,7.5 Z M14.6,2 L16,2 L16,7.5 L14.6,7.5 Z M8,2 L16,2 L16,3.4 L8,3.4 Z M2,12.5 L22,12.5 L22,13.5 L2,13.5 Z" scaleX="0.75" scaleY="0.75" styleClass="icon-box-text, icon-text-promoter" />
                            </StackPane>
                            <VBox spacing="3.0">
                                <Label styleClass="panel-title" text="PROMOTER" />
                                <Label styleClass="panel-subtitle, subtitle-promoter" text="Discover talent, post jobs" />
                            </VBox>
                        </HBox>

                        <VBox spacing="7.0">
                            <Label styleClass="field-label" text="EMAIL" />
                            <TextField fx:id="promoterEmailField" promptText="e.g. booking@venue.com" styleClass="text-field" />
                        </VBox>

                        <VBox spacing="7.0">
                            <Label styleClass="field-label" text="PASSWORD" />
                            <PasswordField fx:id="promoterPasswordField" promptText="••••••••" styleClass="text-field" />
                        </VBox>

                        <HBox alignment="CENTER_RIGHT">
                            <Label styleClass="forgot-link" text="Forgot password?" />
                        </HBox>

                        <Button fx:id="promoterSignInButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePromoterSignIn" styleClass="sign-in-btn, sign-in-btn-promoter" text="SIGN IN">
                            <VBox.margin>
                                <Insets top="6.0" />
                            </VBox.margin>
                        </Button>
                    </VBox>
                </VBox>

            </HBox>

            <Label styleClass="or-divider-text" text="OR CONTINUE WITH">
                <VBox.margin>
                    <Insets bottom="18.0" top="34.0" />
                </VBox.margin>
            </Label>

            <HBox alignment="CENTER" spacing="18.0">
                <Button fx:id="googleLoginButton" mnemonicParsing="false" onAction="#handleGoogleLogin" styleClass="social-btn, google-btn" text="Login with Google" />
                <Button fx:id="spotifyLoginButton" mnemonicParsing="false" onAction="#handleSpotifyLogin" styleClass="social-btn, spotify-btn" text="Login with Spotify" />
            </HBox>

            <Label styleClass="no-account-text" text="You don't have an account?">
                <VBox.margin>
                    <Insets bottom="18.0" top="44.0" />
                </VBox.margin>
            </Label>

            <HBox alignment="CENTER" spacing="18.0">
                <Button fx:id="signUpMusicianButton" mnemonicParsing="false" onAction="#handleSignUpMusician" styleClass="signup-btn, signup-btn-musician">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8.0">
                            <SVGPath content="M9,10 L15,10 L19,13 L19,19 L15,23 L9,23 L5,19 L5,13 Z M11,1 L13,1 L13,10 L11,10 Z M9,0.2 L15,0.2 L13.2,2.2 L10.8,2.2 Z M7,15 L17,15 L17,15.8 L7,15.8 Z M7,17.2 L17,17.2 L17,18 L7,18 Z M7,19.5 L17,19.5 L17,20.1 L7,20.1 Z" scaleX="0.542" scaleY="0.542" styleClass="signup-btn-icon, icon-text-musician" />
                            <Label styleClass="signup-btn-text-musician" text="Sign up as Musician" />
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="signUpPromoterButton" mnemonicParsing="false" onAction="#handleSignUpPromoter" styleClass="signup-btn, signup-btn-promoter">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8.0">
                            <SVGPath content="M2,7 L22,7 L22,20 L2,20 Z M8,2 L9.4,2 L9.4,7.5 L8,7.5 Z M14.6,2 L16,2 L16,7.5 L14.6,7.5 Z M8,2 L16,2 L16,3.4 L8,3.4 Z M2,12.5 L22,12.5 L22,13.5 L2,13.5 Z" scaleX="0.542" scaleY="0.542" styleClass="signup-btn-icon, icon-text-promoter" />
                            <Label styleClass="signup-btn-text-promoter" text="Sign up as Promoter" />
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

        </VBox>
    </center>

    <!-- ===================== FOOTER ===================== -->
    <bottom>
        <VBox alignment="CENTER" styleClass="footer-box" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="22.0" top="18.0" />
            </padding>
            <Label styleClass="footer-text" text="Connecting Musicians · Join Bands · Find Jobs" />
        </VBox>
    </bottom>

</BorderPane>
