<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="rootPane" prefHeight="952.0" prefWidth="1576.0"
            styleClass="root-pane" stylesheets="@../css/musician-dashboard-style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ===================== SIDEBAR ===================== -->
    <left>
        <VBox prefWidth="221.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="24.0" />
            </padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="logo-icon">
                    <SVGPath content="M13,1 L6,13 L11,13 L9,23 L18,9 L12,9 Z" scaleX="0.667" scaleY="0.667" styleClass="logo-icon-text" />
                </StackPane>
                <Label styleClass="logo-text" text="ROCKLINK" />
            </HBox>

            <!-- User profile -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <VBox.margin>
                    <Insets bottom="30.0" top="34.0" />
                </VBox.margin>
                <StackPane styleClass="avatar">
                    <Label fx:id="userAvatarLabel" styleClass="avatar-text" text="AG" />
                </StackPane>
                <VBox spacing="2.0">
                    <Label fx:id="userNameLabel" styleClass="user-name" text="Andrea Greco" />
                    <Label fx:id="userArtistNameLabel" styleClass="user-band" text="THE SIGNAL" />
                    <Label fx:id="userEmailLabel" styleClass="user-email" text="andrea.greco@email.com" />
                </VBox>
            </HBox>

            <!-- Navigation -->
            <VBox spacing="4.0">
                <HBox fx:id="dashboardNavItem" alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-item, nav-item-active">
                    <SVGPath content="M2,12 A10,10 0 1,0 22,12 A10,10 0 1,0 2,12 Z M5,12 A7,7 0 1,0 19,12 A7,7 0 1,0 5,12 Z M8,12 A4,4 0 1,0 16,12 A4,4 0 1,0 8,12 Z" fillRule="EVEN_ODD" scaleX="0.583" scaleY="0.583" styleClass="nav-item-icon" />
                    <Label styleClass="nav-item-text" text="Dashboard" />
                </HBox>

                <HBox fx:id="discoverJobsNavItem" alignment="CENTER_LEFT" onMouseClicked="#handleDiscoverJobs" spacing="10.0" styleClass="nav-item">
                    <SVGPath content="M2,7 L22,7 L22,20 L2,20 Z M8,2 L9.4,2 L9.4,7.5 L8,7.5 Z M14.6,2 L16,2 L16,7.5 L14.6,7.5 Z M8,2 L16,2 L16,3.4 L8,3.4 Z M2,12.5 L22,12.5 L22,13.5 L2,13.5 Z" scaleX="0.583" scaleY="0.583" styleClass="nav-item-icon" />
                    <Label styleClass="nav-item-text" text="Discover Jobs" />
                </HBox>

                <HBox fx:id="discoverBandsNavItem" alignment="CENTER_LEFT" onMouseClicked="#handleDiscoverBands" spacing="10.0" styleClass="nav-item">
                    <SVGPath content="M4.8,6 A2.2,2.2 0 1,0 9.2,6 A2.2,2.2 0 1,0 4.8,6 Z M5,9.5 L9,9.5 L11,17 L3,17 Z M12.9,6.5 A2.6,2.6 0 1,0 18.1,6.5 A2.6,2.6 0 1,0 12.9,6.5 Z M13,10 L18,10 L20.5,19 L10.5,19 Z" scaleX="0.583" scaleY="0.583" styleClass="nav-item-icon" />
                    <Label styleClass="nav-item-text" text="Discover Bands" />
                </HBox>

                <HBox fx:id="myBandsNavItem" alignment="CENTER_LEFT" onMouseClicked="#handleMyBands" spacing="10.0" styleClass="nav-item">
                    <SVGPath content="M4.8,18 A3.2,3.2 0 1,0 11.2,18 A3.2,3.2 0 1,0 4.8,18 Z M10.6,3 L12,3 L12,18 L10.6,18 Z M12,3 L17,6 L12,9 Z" scaleX="0.583" scaleY="0.583" styleClass="nav-item-icon" />
                    <Label styleClass="nav-item-text" text="My Bands" />
                </HBox>

                <HBox fx:id="profileNavItem" alignment="CENTER_LEFT" onMouseClicked="#handleProfile" spacing="10.0" styleClass="nav-item">
                    <SVGPath content="M8,8 A4,4 0 1,0 16,8 A4,4 0 1,0 8,8 Z M8,13 L16,13 L21,22 L3,22 Z" scaleX="0.583" scaleY="0.583" styleClass="nav-item-icon" />
                    <Label styleClass="nav-item-text" text="Profile" />
                </HBox>

                <HBox fx:id="settingsNavItem" alignment="CENTER_LEFT" onMouseClicked="#handleSettings" spacing="10.0" styleClass="nav-item">
                    <SVGPath content="M5,12 A7,7 0 1,0 19,12 A7,7 0 1,0 5,12 Z M8.2,12 A3.8,3.8 0 1,0 15.8,12 A3.8,3.8 0 1,0 8.2,12 Z M19.6,12 A1.9,1.9 0 1,0 23.4,12 A1.9,1.9 0 1,0 19.6,12 Z M16.82,18.72 A1.9,1.9 0 1,0 20.62,18.72 A1.9,1.9 0 1,0 16.82,18.72 Z M10.1,21.5 A1.9,1.9 0 1,0 13.9,21.5 A1.9,1.9 0 1,0 10.1,21.5 Z M3.38,18.72 A1.9,1.9 0 1,0 7.18,18.72 A1.9,1.9 0 1,0 3.38,18.72 Z M0.6,12 A1.9,1.9 0 1,0 4.4,12 A1.9,1.9 0 1,0 0.6,12 Z M3.38,5.28 A1.9,1.9 0 1,0 7.18,5.28 A1.9,1.9 0 1,0 3.38,5.28 Z M10.1,2.5 A1.9,1.9 0 1,0 13.9,2.5 A1.9,1.9 0 1,0 10.1,2.5 Z M16.82,5.28 A1.9,1.9 0 1,0 20.62,5.28 A1.9,1.9 0 1,0 16.82,5.28 Z" fillRule="EVEN_ODD" scaleX="0.583" scaleY="0.583" styleClass="nav-item-icon" />
                    <Label styleClass="nav-item-text" text="Settings" />
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="signOutButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSignOut" styleClass="sign-out-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <SVGPath content="M16.24,4.93 L19.07,7.76 L14.83,12 L19.07,16.24 L16.24,19.07 L12,14.83 L7.76,19.07 L4.93,16.24 L9.17,12 L4.93,7.76 L7.76,4.93 L12,9.17 Z" scaleX="0.542" scaleY="0.542" styleClass="sign-out-icon" />
                        <Label styleClass="sign-out-btn-text" text="Sign out" />
                    </HBox>
                </graphic>
            </Button>

        </VBox>
    </left>

    <!-- ===================== MAIN CONTENT ===================== -->
    <center>
        <VBox BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="28.0" />
            </padding>

            <!-- Header (fisso) -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <VBox spacing="4.0">
                    <Label styleClass="dashboard-title" text="MUSICIAN DASHBOARD" />
                    <Label styleClass="dashboard-subtitle" text="Your applications and activity" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="refreshButton" alignment="CENTER" onMouseClicked="#handleRefresh" spacing="10.0" styleClass="icon-button">
                    <SVGPath content="M3,12 A9,9 0 1,0 21,12 A9,9 0 1,0 3,12 Z M6,12 A6,6 0 1,0 18,12 A6,6 0 1,0 6,12 Z M19,5 L23,5 L21,9 Z M5,19 L1,19 L3,15 Z" fillRule="EVEN_ODD" scaleX="0.625" scaleY="0.625" styleClass="icon-button-text" />
                    <Label styleClass="icon-button-label" text="Refresh" />
                </HBox>
                <HBox fx:id="notificationsButton" alignment="CENTER" onMouseClicked="#handleNotifications" spacing="10.0" styleClass="icon-button">
                    <StackPane>
                        <SVGPath content="M9,11 L9,6 A3,3 0 0,1 15,6 L15,11 L18,17 L6,17 Z M10.7,19 A1.3,1.3 0 1,0 13.3,19 A1.3,1.3 0 1,0 10.7,19 Z M11,4.5 A1,1 0 1,0 13,4.5 A1,1 0 1,0 11,4.5 Z" scaleX="0.625" scaleY="0.625" styleClass="icon-button-text" />
                        <Region fx:id="notificationsDot" managed="false" styleClass="notif-dot" visible="false" StackPane.alignment="TOP_RIGHT" />
                    </StackPane>
                    <Label styleClass="icon-button-label" text="Notifications" />
                </HBox>
            </HBox>

            <!-- Applications: intestazione fissa + lista scrollabile -->
            <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets top="34.0" />
                </VBox.margin>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label styleClass="role-badge, role-badge-musician" text="APPLICATIONS" />
                    <Label fx:id="applicationsCountLabel" styleClass="section-count" text="0 submitted" />
                </HBox>

                <!-- Solo questa lista scrolla: header e titolo sezione restano fissi. -->
                <ScrollPane fitToWidth="true" styleClass="instruments-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="applicationsContainer" spacing="12.0" />
                </ScrollPane>
            </VBox>

        </VBox>
    </center>

</BorderPane>
